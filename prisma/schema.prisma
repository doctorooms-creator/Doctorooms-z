generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ============ USER & ROLES ============

model User {
  id              String   @id @default(cuid())
  name            String
  gender          String   @default("Male")
  role            String   @default("patient") // admin, doctor, patient, hospital, receptionist, assistant, pharmacist
  status          String   @default("Pending") // Pending, Active, Block
  email           String   @unique
  password        String   @default("")
  profileImg      String   @default("default.png")
  mobileNo        String   @default("")
  mobileVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  settingsJson     String   @default("{}") // JSON: {"emailNotifications":true,"bookingReminders":true,"marketingEmails":false}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  doctor          Doctor?
  hospital        Hospital?
  bookings        Booking[]
  posts           Post[]
  sentRatings     DoctorRating[] @relation("PatientRatings")
  receivedRatings DoctorRating[] @relation("DoctorRatings")
  notifications   Notification[]
  chatMessages    BookingChat[]  @relation("ChatSender")
  receivedChats   BookingChat[]  @relation("ChatReceiver")
  inquiries           HospitalInquiry[]
  medicalDocuments     MedicalDocument[]
  receptionistProfile  Receptionist?       @relation("ReceptionistUser")
  assistantProfile    DoctorAssistant?    @relation("AssistantUser")
  pharmacistProfile   DoctorPharmacist?   @relation("PharmacistUser")
  prescriptionAccessRequests PrescriptionAccessRequest[] @relation("PrescriptionAccessPatient")
  assistedPrescriptions Prescription[] @relation("PrescriptionAssistant")
}

// ============ DOCTOR ============

model Doctor {
  id                  String   @id @default(cuid())
  userId              String   @unique
  bookingDays         Int      @default(180)
  dailyLimit          Int      @default(50)
  doctorType          String   @default("")
  description         String   @default("")
  photos              String   @default("[]") // JSON array
  address             String   @default("")
  state               String   @default("")
  city                String   @default("")
  hospitalAddress     String   @default("")
  fees                Float    @default(0)
  emergencyCharge     Float    @default(0)
  specialization     String   @default("")
  awardAndRecognition String   @default("")
  education           String   @default("")
  lat                 Float    @default(0)
  longi               Float    @default(0)
  hospitalId          String?
  experience          String   @default("")
  registrationDetail  String   @default("")
  contactNo           String   @default("")
  phoneNo             String   @default("")
  isEmergency         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  schedules           DoctorSchedule[]
  holidays            DoctorHoliday[]
  medicines           DoctorMedicine[]
  prescriptions       Prescription[]
  assistants          DoctorAssistant[]
  pharmacistLinks     DoctorPharmacist[]
  receptionistLinks   Receptionist[]
  gallery             DoctorGallery[]
  coMaster            CoMaster[]
  labelMaster         LabelMaster[]
  questionMaster      QuestionsMaster[]
  otherSettings       POtherSetting?
  accessRequestsMade  PrescriptionAccessRequest[] @relation("RequestingDoctor")
  accessRequestsReceived PrescriptionAccessRequest[] @relation("OriginalDoctor")
  categories          CategoryMaster[]
  findings            FindingsMaster[]
  tableTemplates      TableTemplateMaster[]
  hospitalLinks       DoctorHospital[]
}

// ============ HOSPITAL ============

model Hospital {
  id           String   @id @default(cuid())
  userId       String   @unique
  hospitalName String   @default("")
  address      String   @default("")
  state        String   @default("")
  city         String   @default("")
  pincode      String   @default("")
  email        String   @default("")
  contactNo    String   @default("")
  website      String   @default("")
  image        String   @default("")     // Hospital logo/banner
  about        String   @default("")     // About hospital
  hospitalType String   @default("Multi-Specialty") // Multi-Specialty, Single-Specialty, Clinic, Diagnostic Center
  establishedYear Int  @default(0)
  bedCount     Int      @default(0)
  accreditation String  @default("")    // NABH, JCI, etc.
  facilities   String   @default("[]")   // JSON array: ["ICU","MRI","CT Scan"]
  gallery      String   @default("[]")   // JSON array
  lat          Float    @default(0)
  longi        Float    @default(0)
  status       String   @default("Active") // Active, Inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments  Department[]
  doctorLinks  DoctorHospital[]
  receptionists Receptionist[]
}

// ============ DEPARTMENT ============

model Department {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String   @default("")       // e.g. "Cardiology", "Orthopedics"
  nameHi      String   @default("")       // Hindi name
  description String   @default("")
  icon        String   @default("")       // Lucide icon name: HeartPulse, Bone, Brain, etc.
  floorNo     String   @default("")       // e.g. "Floor 2", "Ground Floor"
  opdRoom     String   @default("")       // e.g. "OPD Room 201"
  status      String   @default("Active")  // Active, Inactive
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorLinks DoctorHospital[]
  receptionists Receptionist[]
}

// ============ DOCTOR-HOSPITAL JUNCTION (Many-to-Many with Department) ============

model DoctorHospital {
  id            String   @id @default(cuid())
  doctorId      String   // Doctor.id
  hospitalId    String   // Hospital.id
  departmentId  String   // Department.id
  designation   String   @default("")    // Senior Consultant, HOD, Junior Resident, etc.
  fees          Float    @default(0)      // Consultation fee at THIS hospital
  opdTimings    String   @default("")    // e.g. "Mon/Wed/Fri 10:00-1:00"
  isAvailable   Boolean  @default(true)   // Currently accepting patients
  status        String   @default("Active") // Active, Inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor      Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital    Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId, departmentId])
}

// ============ APPOINTMENTS ============

model Booking {
  id               String   @id @default(cuid())
  appointmentNo    String   @unique @default("")
  doctorId         String
  userId           String?  // patient, null for walk-ins
  state            String   @default("")
  city             String   @default("")
  bookingDate      DateTime @default(now())
  patientName      String   @default("")
  disease          String   @default("")
  description      String   @default("")
  gender           String   @default("")
  dateOfBirth      DateTime?
  age              Int?
  relationWithMe   String   @default("")
  bloodGroup       String   @default("")
  weight           Float    @default(0)
  height           Float    @default(0)
  physicallyChallenged String @default("No")
  status           String   @default("Pending") // Pending, Approve, Visited, Canceled, Extend, Finish
  timeSlot         String   @default("") // e.g. "10:00 AM"
  bookingMode      String   @default("InPerson") // InPerson, VideoCall
  videoRoomId      String   @default("") // Jitsi room ID for video calls
  bookingType      String   @default("By Self") // By Self, By Receptionist, By Hospital
  appointmentCharge Float   @default(0)
  hospitalId       String?         // Hospital where booked (for multi-specialty)
  departmentId     String?         // Department selected (for multi-specialty)
  tokenNumber      String   @default("")  // OPD token number e.g. "CARD-015"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctor           Doctor   @relation(fields: [doctorId], references: [id])
  user             User?    @relation(fields: [userId], references: [id])
  chatMessages     BookingChat[]
  prescriptions    Prescription[]
}

// ============ BOOKING CHAT ============

model BookingChat {
  id        String   @id @default(cuid())
  bookingId String
  fromId    String
  toId      String
  message   String
  status    String   @default("UNREAD") // READ, UNREAD
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation("ChatSender", fields: [fromId], references: [id])
  receiver  User     @relation("ChatReceiver", fields: [toId], references: [id])
}

// ============ PRESCRIPTION ============

model Prescription {
  id           String   @id @default(cuid())
  bookingId    String
  patientName  String   @default("")
  patientAge   String   @default("")
  disease      String   @default("")
  weight       String   @default("")
  bp           String   @default("")
  temperature  String   @default("")
  description  String   @default("")
  status       String   @default("Draft") // Draft, Active, Archived
  nextVisit    DateTime?
  assistantId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  doctorId     String
  assistant    User?    @relation("PrescriptionAssistant", fields: [assistantId], references: [id])
  medicines    PMedicine[]
  labels       PLabel[]
  suggestions  PSuggestion[]
  diagnosisTables PDignoTable[]
  chiefComplaints PCo[]
  accessRequests    PrescriptionAccessRequest[]
}

model PMedicine {
  id          String   @id @default(cuid())
  prescriptionId String
  medicine    String   @default("")
  morning     Int      @default(0)      // tablet count (0 = skip)
  afternoon   Int      @default(0)      // tablet count (0 = skip)
  evening     Int      @default(0)      // tablet count (0 = skip)
  tab         Int      @default(1)       // total days
  dose        String   @default("")     // selected dose value
  description String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PLabel {
  id             String   @id @default(cuid())
  prescriptionId String
  label          String   @default("")
  labelEn        String   @default("")
  value          String   @default("")
  labelUnit      String   @default("")
  showUnit       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PSuggestion {
  id             String   @id @default(cuid())
  prescriptionId String
  question       String   @default("")
  questionEn     String   @default("")
  suggestions    String   @default("")
  suggestionsEn  String   @default("")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PDignoTable {
  id             String   @id @default(cuid())
  prescriptionId String
  templateId     String?
  rows           Int      @default(3)
  cols           Int      @default(2)
  headerLabel    String   @default("[]") // JSON
  colsLabel      String   @default("[]") // JSON
  footerLabel    String   @default("[]") // JSON
  extraLabel     String   @default("")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PCo {
  id             String   @id @default(cuid())
  prescriptionId String
  coId           String
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model POtherSetting {
  id            String   @id @default(cuid())
  doctorId      String   @unique
  logo          String   @default("")
  time          String   @default("{}") // JSON: timing config
  header        String   @default("")
  fullHeader    String   @default("")
  isFullHeader  Boolean  @default(false)
  footer        String   @default("")
  showCoInPrint Boolean  @default(true)
  showNextVisit Boolean  @default(true)
  printLayout   String   @default("standard") // standard, compact, detailed
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR RATING ============

model DoctorRating {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  bookingId String?
  star      Int      @default(5)
  consultationRating Int @default(0)
  waitTimeRating    Int @default(0)
  staffRating       Int @default(0)
  review    String   @default("")
  wouldRecommend Boolean @default(true)
  isAnonymous Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   User     @relation("PatientRatings", fields: [patientId], references: [id])
  doctor   User     @relation("DoctorRatings", fields: [doctorId], references: [id])
}

// ============ DOCTOR SCHEDULE ============

model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  day       String // Monday-Sunday
  startTime String   @default("09:00")
  endTime   String   @default("17:00")
  slotDuration Int   @default(30) // minutes
  timeSlots String   @default("[]") // JSON array of manual slots e.g. ["09:00","09:30","10:00"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model DoctorHoliday {
  id        String   @id @default(cuid())
  userId    String // doctor user id
  date      DateTime
  remark    String   @default("")
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR MEDICINE LIST ============

model DoctorMedicine {
  id          String   @id @default(cuid())
  name        String   @default("")
  morning     Int      @default(0)       // tablet count (0 = skip)
  afternoon   Int      @default(0)       // tablet count
  evening     Int      @default(0)       // tablet count
  dose        String   @default("[]")    // JSON array e.g. ["500mg","650mg","1000mg"]
  tab         Int      @default(1)        // total days
  description String   @default("")
  status      String   @default("Active")
  createdById String?
  userId      String // doctor user id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings    FindingsMedicine[]
}

// ============ CATEGORY MASTER ============

model CategoryMaster {
  id          String   @id @default(cuid())
  name        String   @default("")       // primary language
  nameEn      String   @default("")       // English
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  complaints  CoMaster[]
}

// ============ FINDINGS MASTER ============

model FindingsMaster {
  id          String   @id @default(cuid())
  name        String   @default("")       // primary language
  nameEn      String   @default("")       // English
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicines   FindingsMedicine[]
}

model FindingsMedicine {
  id              String   @id @default(cuid())
  findingId       String
  medicineId      String
  dose            String   @default("")     // override dose (blank = use master default)
  morning         Int      @default(0)      // override morning count
  afternoon       Int      @default(0)      // override afternoon count
  evening         Int      @default(0)      // override evening count
  tab             Int      @default(0)      // override days (0 = use master default)
  description     String   @default("")     // override description
  createdAt       DateTime @default(now())

  finding         FindingsMaster  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  medicine        DoctorMedicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([findingId, medicineId])
}

// ============ TABLE TEMPLATE MASTER ============

model TableTemplateMaster {
  id          String   @id @default(cuid())
  name        String   @default("")
  rows        Int      @default(3)
  cols        Int      @default(2)
  headerLabel String   @default("[]")       // JSON: column headers
  colsLabel   String   @default("[]")       // JSON: row labels
  footerLabel String   @default("[]")       // JSON: footer rows
  extraLabel  String   @default("")
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR ASSISTANT ============

model DoctorAssistant {
  id          String   @id @default(cuid())
  userId      String   @unique // assistant user id
  doctorId    String // doctor id (Doctor model)
  description String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())

  user        User     @relation("AssistantUser", fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR PHARMACIST ============

model DoctorPharmacist {
  id          String   @id @default(cuid())
  userId      String   @unique // pharmacist user id
  doctorId    String // doctor id (Doctor model)
  description String   @default("")
  address     String   @default("")
  dlNo        String   @default("") // Drug license number
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("PharmacistUser", fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ RECEPTIONIST ============

model Receptionist {
  id          String   @id @default(cuid())
  userId      String   @unique // receptionist user id
  doctorId    String          // doctor id (Doctor model) — for clinic-mode receptionists
  hospitalId  String?         // hospital id — for multi-specialty hospital receptionists
  departmentId String?        // department id — if assigned to specific department OPD
  address     String   @default("")
  createdAt   DateTime @default(now())

  user        User     @relation("ReceptionistUser", fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR TYPE MASTER ============

model DoctorTypeMaster {
  id        String   @id @default(cuid())
  type      String   @default("")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ BLOG / POSTS ============

model Post {
  id        String   @id @default(cuid())
  title     String   @default("")
  permalink String   @unique @default("")
  content   String   @default("")
  blogImg   String   @default("")
  videoLink String   @default("")
  type      String   @default("Blog") // Blog, News
  status    String   @default("Draft") // Published, Draft
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  message   String   @default("")
  status    String   @default("UNREAD") // READ, UNREAD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ SLIDER ============

model Slider {
  id           String   @id @default(cuid())
  sliderImage  String   @default("")
  position     Int      @default(0)
  status       String   @default("Active")
  link         String   @default("")
  title        String   @default("")
  subtitle     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ HOSPITAL INQUIRY ============

model HospitalInquiry {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  subject   String   @default("")
  message   String   @default("")
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

// ============ DISEASE MASTER ============

model DiseaseMaster {
  id        String   @id @default(cuid())
  name      String   @default("")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ LABEL MASTER ============

model LabelMaster {
  id          String   @id @default(cuid())
  label       String   @default("")        // primary language
  labelEn     String   @default("")        // English
  unit        String   @default("")        // e.g., "mg/dL", "%", "mmHg"
  showUnit    Boolean  @default(true)       // whether to show unit after value in print
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ CO MASTER (Chief Complaints) ============

model CoMaster {
  id          String   @id @default(cuid())
  coCode      String   @default("")
  coDetail    String   @default("")        // primary language (shown in stepper)
  coDetailEn  String   @default("")        // English (used in print)
  categoryId  String?
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category    CategoryMaster? @relation(fields: [categoryId], references: [id])
  questions   QuestionsMaster[] @relation("QuestionCo")
}

// ============ QUESTIONS MASTER ============

model QuestionsMaster {
  id          String   @id @default(cuid())
  question    String   @default("")        // primary language
  questionEn  String   @default("")        // English
  explanation String   @default("")
  coId        String?
  status      String   @default("Active")
  createdById String?
  doctorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  co          CoMaster? @relation("QuestionCo", fields: [coId], references: [id])
  suggestions SuggestionsMaster[]
}

// ============ SUGGESTIONS MASTER ============

model SuggestionsMaster {
  id           String   @id @default(cuid())
  questionId   String
  suggestions  String   @default("")        // primary language
  suggestionsEn String   @default("")       // English
  status       String   @default("Active")
  createdById  String?
  doctorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question     QuestionsMaster @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ============ DOCTOR GALLERY ============

model DoctorGallery {
  id        String   @id @default(cuid())
  doctorId  String
  image     String   @default("")
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

// ============ PRESCRIPTION ACCESS REQUEST (Patient Consent) ============

model PrescriptionAccessRequest {
  id                 String   @id @default(cuid())
  prescriptionId     String // prescription being requested
  requestingDoctorId String // Doctor.id of the doctor requesting access (Doctor Z)
  patientId          String // User.id of the patient who owns this prescription
  originalDoctorId   String // Doctor.id of the doctor who created the prescription (Doctor Y)
  status             String   @default("Pending") // Pending, Approved, Rejected
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  requestingDoctor   Doctor      @relation("RequestingDoctor", fields: [requestingDoctorId], references: [id])
  originalDoctor     Doctor      @relation("OriginalDoctor", fields: [originalDoctorId], references: [id])
  patient            User        @relation("PrescriptionAccessPatient", fields: [patientId], references: [id])
}

// ============ MEDICAL DOCUMENTS ============

model MedicalDocument {
  id          String   @id @default(cuid())
  patientId   String
  title       String   @default("")
  category    String   @default("Other")
  fileUrl     String   @default("")
  fileName    String   @default("")
  fileSize    Int      @default(0)
  mimeType    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
